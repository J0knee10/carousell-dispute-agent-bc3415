# Secrets
.env
.streamlit/secrets.toml

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Large or downloaded data (see README for where to get it)
data/raw/

# Generated at runtime. The per-case predictions in outputs/runs/ are kept in
# git so every number in reports/ can be checked; logs, the decision log,
# and the what-if cache are not.
.chroma/
outputs/*
!outputs/runs/
!outputs/runs_discarded/
!outputs/whatif/
outputs/whatif/*
!outputs/whatif/whatif_20261028_231316.json

# Demo video exports (too large for git; submitted separately)
*.mp4
*.mov
*.mkv

# Node packages (installed from a package.json, never committed)
node_modules/

# Local Claude Code settings
.claude/settings.local.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
