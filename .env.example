# Copy this file to .env and fill in the values. .env is gitignored.

# Free-tier Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. OpenAI key (free usage tier is enough): the app's fallback when a Gemini call fails.
OPENAI_API_KEY=

# Optional overrides (defaults are in config.yaml).
# LLM_PROVIDER=gemini        # gemini | ollama | openai | mock
# GEMINI_MODEL=gemini-flash-lite-latest
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_HOST=http://localhost:11434
# OPENAI_MODEL=gpt-5.4-mini
